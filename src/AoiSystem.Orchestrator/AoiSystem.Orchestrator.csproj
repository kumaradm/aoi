<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AoiSystem.Orchestrator</RootNamespace>
    <AssemblyName>AoiSystem.Orchestrator</AssemblyName> 
    <UserSecretsId>62b32015-02f8-4249-8e4a-7108463146f6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
      <None Include="Interop/libimage_processor.so">
          <!-- This forces it to copy directly to the output root, skipping the Interop/ folder -->
          <Link>libimage_processor.so</Link>
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>
